# Cadena de conexion de Neon DB (PostgreSQL). Obligatoria.
DATABASE_URL=postgresql://usuario:password@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# PIN de acceso para vendedores. Opcional pero recomendado: si se define,
# la aplicacion lo solicita una vez por dispositivo y protege los datos
# de los compradores (nombres y telefonos).
ADMIN_PIN=

# Valor de cada boleto en pesos colombianos. Por defecto 10000.
PRECIO_BOLETO=10000

# Nombre de la tabla en la base de datos. Opcional, por defecto boletos_rifa.
# Use uno distinto por rifa si varias rifas comparten la misma base de datos.
NOMBRE_TABLA=boletos_rifa

# Puerto del servidor (Railway lo asigna automaticamente).
PORT=3000
